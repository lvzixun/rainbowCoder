---
import '../styles/global.css';
import '../styles/geek.css';
import Icon from '../components/Icon.astro';
import { site, withBase, stripBase } from '../lib/site.mjs';
interface Props { title?: string; description?: string; article?: boolean; date?: string; updated?: string }
const { title, description = site.description, article = false, date, updated } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · zixun 的技术笔记`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = stripBase(Astro.url.pathname);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="rainbowCoder RSS" href={withBase('/rainbowcoder_rss.xml')} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {date && <meta property="article:published_time" content={date} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    <script is:inline>
      try {
        const saved = localStorage.getItem('rainbowcoder-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      } catch { document.documentElement.dataset.theme = 'dark'; }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">跳到正文</a>
    <header class="site-header shell">
      <a class="brand" href={withBase('/')} aria-label="rainbowCoder 首页"><span class="brand-code" aria-hidden="true">&lt;/&gt;</span><span>rainbow<span class="brand-light">Coder</span><span class="brand-period">_</span></span></a>
      <nav class="site-nav" aria-label="主导航">
        <a href={withBase('/')} aria-current={path === '/' ? 'page' : undefined}><span class="nav-prefix" aria-hidden="true">01</span>文章</a>
        <a href={withBase('/archive/')} aria-current={path.startsWith('/archive') ? 'page' : undefined}><span class="nav-prefix" aria-hidden="true">02</span>归档</a>
        <a href={withBase('/about/')} aria-current={path.startsWith('/about') ? 'page' : undefined}><span class="nav-prefix" aria-hidden="true">03</span>关于</a>
      </nav>
      <div class="header-tools">
        <a class="icon-button social-link" href={site.github} aria-label="zixun 的 GitHub" target="_blank" rel="noopener noreferrer"><Icon name="github" /></a>
        <button class="icon-button theme-toggle" type="button" aria-label="切换深色主题"><span class="sun-icon"><Icon name="sun" /></span><span class="moon-icon"><Icon name="moon" /></span></button>
      </div>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell">
      <span><span class="footer-prompt" aria-hidden="true">λ</span> © {new Date().getFullYear()} zixun<span class="footer-separator">/</span>rainbowCoder</span>
      <div><a href={site.repository} target="_blank" rel="noopener noreferrer">源码</a><a href={withBase('/rainbowcoder_rss.xml')}><Icon name="rss" size={15} /> RSS</a><a href={`mailto:${site.email}`}>联系</a></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const updateLabel = () => toggle?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换浅色主题' : '切换深色主题');
      updateLabel();
      toggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('rainbowcoder-theme', theme); } catch {}
        updateLabel();
      });
    </script>
  </body>
</html>
