---
import { withBase } from '../lib/site.mjs';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import { posts, tags } from '../lib/posts';
---
<Base>
  <section class="intro">
    <div class="intro-copy">
      <p class="eyebrow"><span class="tiny-rule"></span>NOTES ON CODE &amp; CURIOSITY</p>
      <h1>拆开代码，<br /><span class="intro-emphasis">记下思考。</span></h1>
      <p class="intro-description">读源码，造轮子，把问题想明白。<br />关于 Lua、编译器与游戏服务端的探索笔记。</p>
      <p class="intro-signature">保持好奇，慢慢把事情想明白。<span>— zixun</span></p>
    </div>
    <div class="intro-bottom"><span>始于 2014<span class="meta-dot">·</span>{posts.length} 篇笔记</span><a href={withBase('/rainbowcoder_rss.xml')}><Icon name="rss" size={16} /> 订阅更新</a></div>
  </section>
  <div class="home-grid">
    <section class="articles-section" aria-label="文章列表">
      <div class="section-heading"><h2>写下来的思考<span id="result-count">{posts.length}</span></h2><span class="section-note">最新优先</span></div>
      <div class="mobile-filter"><label for="tag-select" class="sr-only">按主题筛选</label><select id="tag-select"><option value="">全部主题</option>{tags.map(tag => <option value={tag}>{tag}</option>)}</select></div>
      <PostList items={posts} filterable />
      <p class="no-results" hidden>没有找到相关文章。试试其他关键词，或<button id="reset-search" type="button">清除筛选</button>。</p>
      <p id="search-announcement" class="sr-only" aria-live="polite"></p>
      <p class="list-end">写到这里，下次继续。<span aria-hidden="true">↗</span></p>
    </section>
    <aside class="home-sidebar">
      <div class="sidebar-sticky">
        <div class="search-box"><Icon name="search" size={17} /><label for="search" class="sr-only">搜索文章</label><input id="search" type="search" placeholder="搜索文章…" autocomplete="off" /></div>
        <div class="topic-filter"><h2 class="sidebar-heading">探索主题</h2><div class="topic-buttons"><button type="button" class="active" data-filter="" aria-pressed="true"><span>全部文章</span><span>{posts.length}</span></button>{tags.map(tag => <button type="button" data-filter={tag} aria-pressed="false"><span>{tag}</span><span>{posts.filter(p => p.tags.includes(tag)).length}</span></button>)}</div></div>
        <div class="sidebar-note"><svg class="note-sketch" width="62" height="54" viewBox="0 0 62 54" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M15 47C20 33 29 19 46 8M25 30C12 33 10 22 12 18C22 15 29 19 25 30ZM34 20C31 6 39 3 44 5C47 12 43 18 34 20ZM30 26C35 35 47 32 49 25C42 20 35 20 30 26Z" /></svg><p>代码与文字，<br />都是理解世界的方式。</p><a href={withBase('/about/')}>关于 zixun</a></div>
      </div>
    </aside>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('#search')!;
    const select = document.querySelector<HTMLSelectElement>('#tag-select')!;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const rows = [...document.querySelectorAll<HTMLElement>('[data-post]')];
    let selected = '';
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      let count = 0;
      for (const row of rows) {
        const match = (!selected || JSON.parse(row.dataset.tags!).includes(selected)) && (!query || row.dataset.search!.includes(query));
        row.hidden = !match;
        if (match) count++;
      }
      buttons.forEach(button => {
        const active = button.dataset.filter === selected;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      select.value = selected;
      document.querySelector('#result-count')!.textContent = String(count);
      document.querySelector<HTMLElement>('.no-results')!.hidden = count > 0;
      document.querySelector<HTMLElement>('.list-end')!.hidden = count === 0;
      document.querySelector('#search-announcement')!.textContent = `找到 ${count} 篇文章`;
    };
    input.addEventListener('input', filter);
    buttons.forEach(button => button.addEventListener('click', () => { selected = button.dataset.filter!; filter(); }));
    select.addEventListener('change', () => { selected = select.value; filter(); });
    document.querySelector('#reset-search')?.addEventListener('click', () => { input.value = ''; selected = ''; filter(); input.focus(); });
  </script>
</Base>
